# Prove the optimized core against the preserved v3 baseline.
read_verilog baseline/rv32i_core.v
proc
memory_map
opt
rename rv32i_core gold
design -stash gold
read_verilog rtl/rv32i_core.v
proc
memory_map
opt
rename rv32i_core gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
equiv_make gold gate equiv
hierarchy -top equiv
equiv_simple
equiv_induct -seq 4
equiv_status -assert
